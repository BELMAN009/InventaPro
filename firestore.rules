rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Helper: Product
    function isValidProduct(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 120 &&
             data.code is string &&
             data.code.size() >= 1 &&
             data.code.size() <= 60 &&
             data.category is string &&
             data.category.size() >= 1 &&
             data.category.size() <= 60 &&
             data.unit is string &&
             data.unit.size() >= 1 &&
             data.unit.size() <= 30 &&
             data.supplier is string &&
             data.supplier.size() <= 120 &&
             data.quantity is int &&
             data.quantity >= 0 &&
             data.quantity <= 1000000 &&
             data.minStock is int &&
             data.minStock >= 0 &&
             data.minStock <= 1000000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    // Validation Helper: StockEntry
    function isValidStockEntry(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.productId is string &&
             data.productId.size() >= 1 &&
             data.productId.size() <= 128 &&
             data.productName is string &&
             data.productName.size() >= 1 &&
             data.productName.size() <= 120 &&
             data.productCode is string &&
             data.productCode.size() >= 1 &&
             data.productCode.size() <= 60 &&
             data.addedQuantity is int &&
             data.addedQuantity > 0 &&
             data.addedQuantity <= 1000000 &&
             data.previousQuantity is int &&
             data.previousQuantity >= 0 &&
             data.previousQuantity <= 1000000 &&
             data.newQuantity is int &&
             data.newQuantity == data.previousQuantity + data.addedQuantity &&
             data.supplier is string &&
             data.supplier.size() <= 120 &&
             data.notes is string &&
             data.notes.size() <= 300 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    // Validation Helper: TaskItem
    function isValidTask(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 150 &&
             data.description is string &&
             data.description.size() <= 500 &&
             data.category is string &&
             data.category.size() >= 1 &&
             data.category.size() <= 60 &&
             data.priority is string &&
             data.priority in ['ALTA', 'MEDIA', 'BAJA'] &&
             data.completed is bool &&
             data.dueDateMillis is int &&
             data.dueDateMillis >= 0 &&
             data.reminderEnabled is bool &&
             data.linkedProductId is string &&
             data.linkedProductId.size() <= 128 &&
             data.linkedProductName is string &&
             data.linkedProductName.size() <= 120 &&
             data.autoGenerated is bool &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    // Collection: /products/{productId}
    match /products/{productId} {
      allow get, delete: if isSignedIn() &&
                            isValidId(productId) &&
                            existing().userId == request.auth.uid;

      allow list: if isSignedIn() &&
                     existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(productId) &&
                       incoming().keys().hasAll([
                         'userId', 'name', 'code', 'category', 'unit',
                         'supplier', 'quantity', 'minStock', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'name', 'code', 'category', 'unit',
                         'supplier', 'quantity', 'minStock', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidProduct(incoming());

      allow update: if isSignedIn() &&
                       isValidId(productId) &&
                       isValidProduct(incoming()) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'name', 'code', 'category', 'unit',
                         'supplier', 'quantity', 'minStock', 'updatedAt'
                       ]);
    }

    // Collection: /stock_entries/{entryId}
    match /stock_entries/{entryId} {
      allow get, delete: if isSignedIn() &&
                            isValidId(entryId) &&
                            existing().userId == request.auth.uid;

      allow list: if isSignedIn() &&
                     existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(entryId) &&
                       incoming().keys().hasAll([
                         'userId', 'productId', 'productName', 'productCode',
                         'addedQuantity', 'previousQuantity', 'newQuantity',
                         'supplier', 'notes', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'productId', 'productName', 'productCode',
                         'addedQuantity', 'previousQuantity', 'newQuantity',
                         'supplier', 'notes', 'createdAt'
                       ]) &&
                       isValidStockEntry(incoming());

      allow update: if false;
    }

    // Collection: /tasks/{taskId}
    match /tasks/{taskId} {
      allow get, delete: if isSignedIn() &&
                            isValidId(taskId) &&
                            existing().userId == request.auth.uid;

      allow list: if isSignedIn() &&
                     existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(taskId) &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'description', 'category', 'priority',
                         'completed', 'dueDateMillis', 'reminderEnabled',
                         'linkedProductId', 'linkedProductName', 'autoGenerated',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'description', 'category', 'priority',
                         'completed', 'dueDateMillis', 'reminderEnabled',
                         'linkedProductId', 'linkedProductName', 'autoGenerated',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidTask(incoming());

      allow update: if isSignedIn() &&
                       isValidId(taskId) &&
                       isValidTask(incoming()) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'description', 'category', 'priority',
                         'completed', 'dueDateMillis', 'reminderEnabled',
                         'linkedProductId', 'linkedProductName', 'autoGenerated',
                         'updatedAt'
                       ]);
    }
  }
}
